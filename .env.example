# Production site URL (no trailing slash) — used for canonical URLs, sitemap, schema
NEXT_PUBLIC_SITE_URL=https://nourishnirvana.in

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML tag verification content value
NEXT_PUBLIC_GSC_VERIFICATION=

# Contact form endpoint — FormSubmit (recommended) or Web3Forms
# FormSubmit: https://formsubmit.co/ajax/your@email.com
# Web3Forms: https://api.web3forms.com/submit (also set access key below)
NEXT_PUBLIC_FORM_ENDPOINT=

# Required only when using Web3Forms
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
